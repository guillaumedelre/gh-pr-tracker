# Copy this file to .env and adjust values to your setup.
# .env is gitignored and never committed.

# Auto-refresh interval in seconds (default: 300 = 5 minutes)
REFRESH_INTERVAL=300

# Comma-separated GitHub namespaces (orgs/users) to hide from the PR list.
# Example: HIDDEN_NAMESPACES=my-login,my-company
HIDDEN_NAMESPACES=
